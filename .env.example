# Firebase Web SDK Configuration Example (Client-Side)
# Copy this file to .env.local and fill in your Firebase Web App credentials
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=sangam-30ac8.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sangam-30ac8
VITE_FIREBASE_STORAGE_BUCKET=sangam-30ac8.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Express Backend Base URL (defaults to http://localhost:3001 in dev)
# In production, set to your backend domain (e.g. https://api.sangam.edu) or leave empty if reverse-proxied
VITE_API_BASE_URL=http://localhost:3001

# ===============================================================
# Backend Express Server Configuration (Server-Only - DO NOT prefix with VITE_)
# ===============================================================
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OAuth Token Encryption Key (Server-Only, 32 bytes hex or base64)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Firebase Admin SDK Configuration (Server-Only)
# Option A: Path to service account key file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
# Option B: Direct environment variables
FIREBASE_PROJECT_ID=sangam-30ac8
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ===============================================================
# Google Drive OAuth 2.0 Configuration (Server-Only)
# ===============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/storage/google/callback
FRONTEND_URL=http://localhost:5173


